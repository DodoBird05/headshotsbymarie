{
  "name": "headshots-by-marie",
  "version": "1.0.0",
  "description": "Headshots By Marie - Where artistry meets authenticity. Professional headshot photography website built with Next.js",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:stable": "node scripts/dev-stable.js",
    "dev:clean": "./scripts/cleanup.sh && next dev -p 3100",
    "generate-thumbs": "node scripts/generate-thumbnails.js",
    "build": "node scripts/generate-thumbnails.js && next build",
    "export": "next build",
    "deploy:aws": "node scripts/deploy-aws.js",
    "start": "next start -p 3100",
    "lint": "next lint",
    "clean": "./scripts/cleanup.sh",
    "logs": "tail -f logs/dev-server.log",
    "logs:error": "tail -f logs/dev-server-errors.log"
  },
  "keywords": [
    "photography",
    "nextjs",
    "website",
    "portfolio"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "autoprefixer": "10.4.22",
    "framer-motion": "^12.34.2",
    "gray-matter": "4.0.3",
    "lucide-react": "0.560.0",
    "next": "16.2.9",
    "postcss": "8.5.13",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "devDependencies": {
    "@types/node": "25.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.9",
    "prettier": "3.7.4",
    "sharp": "^0.34.5"
  },
  "pnpm": {
    "comment-overrides": "Force patched in-major versions of dev/build-time transitive deps to clear pnpm audit CVEs (eslint toolchain + gray-matter's js-yaml). All same-major bumps, no API breaks. Reviewed 2026-06-30.",
    "overrides": {
      "minimatch@3": "3.1.5",
      "flatted": "3.4.2",
      "ajv@6": "6.15.0",
      "brace-expansion@1": "1.1.15",
      "brace-expansion@5": "5.0.7",
      "js-yaml@3": "3.15.0",
      "js-yaml@4": "4.3.0",
      "@babel/core": "7.29.7"
    }
  }
}
