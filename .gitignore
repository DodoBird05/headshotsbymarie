node_modules
.next
out/
# TypeScript incremental cache, rewritten by every type check
*.tsbuildinfo
.DS_Store
*.log

# Development logs
logs/

# Lock files (if switching package managers)
package-lock.json
yarn.lock

# Cache directories
node_modules/.cache
.next/cache

# Environment files. The repo is public on GitHub, so any .env with a real
# key must never be committed. Ignore them all by default; .env.example is
# for documenting variable names, and .env.development is tracked on purpose
# (PORT, NODE_ENV and Node options only, no secrets).
.env*
!.env.example
!.env.development
